*          text=auto

*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.tif      binary
*.tiff     binary
*.ico      binary
*.svg      text
*.eps      binary

*.bash     text eol=lf
*.fish     text eol=lf
*.ksh      text eol=lf
*.sh       text eol=lf
*.zsh      text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

*.json     text
*.toml     text
*.xml      text
*.yaml     text
*.yml      text

*.patch    -text

.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore

